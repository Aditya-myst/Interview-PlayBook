### Stored Procedures

A **stored procedure** is a prepared SQL code saved in the database.

```sql
-- Create a stored procedure
DELIMITER //
CREATE PROCEDURE GetEmployeesByDept(IN deptName VARCHAR(50))
BEGIN
    SELECT Name, Salary
    FROM Employees
    WHERE Department = deptName
    ORDER BY Salary DESC;
END //
DELIMITER ;

-- Call the procedure
CALL GetEmployeesByDept('CS');
```

#### Parameters

```sql
-- IN: Input parameter (default)
-- OUT: Output parameter
-- INOUT: Both

DELIMITER //
CREATE PROCEDURE GetDeptStats(
    IN deptName VARCHAR(50),
    OUT empCount INT,
    OUT avgSalary DECIMAL(10,2)
)
BEGIN
    SELECT COUNT(*), AVG(Salary)
    INTO empCount, avgSalary
    FROM Employees
    WHERE Department = deptName;
END //
DELIMITER ;

-- Call with output
CALL GetDeptStats('CS', @count, @avg);
SELECT @count, @avg;
```

#### Control Flow

```sql
DELIMITER //
CREATE PROCEDURE GiveRaise(
    IN empID INT,
    IN percent DECIMAL(5,2)
)
BEGIN
    DECLARE currentSalary DECIMAL(10,2);
    
    SELECT Salary INTO currentSalary FROM Employees WHERE ID = empID;
    
    IF currentSalary < 50000 THEN
        UPDATE Employees SET Salary = Salary * (1 + percent/100) WHERE ID = empID;
    ELSEIF currentSalary < 100000 THEN
        UPDATE Employees SET Salary = Salary * (1 + percent/200) WHERE ID = empID;
    ELSE
        -- No raise for high earners
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Salary too high for raise';
    END IF;
END //
DELIMITER ;
```

#### Cursors

Process rows one at a time.

```sql
DELIMITER //
CREATE PROCEDURE ProcessAllEmployees()
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE empName VARCHAR(100);
    DECLARE emp CURSOR FOR SELECT Name FROM Employees;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    OPEN emp;
    
    read_loop: LOOP
        FETCH emp INTO empName;
        IF done THEN LEAVE read_loop; END IF;
        -- Process each employee
        SELECT empName;
    END LOOP;
    
    CLOSE emp;
END //
DELIMITER ;
```

