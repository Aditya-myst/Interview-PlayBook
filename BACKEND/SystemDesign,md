### Complete System Design Implementations

#### URL Shortener

```javascript
const express = require('express');
const crypto = require('crypto');
const redis = require('./redis');
const db = require('./db');

const app = express();

// Generate short code
function generateShortCode(url) {
    const hash = crypto.createHash('md5').update(url).digest('base64');
    return hash.substring(0, 7).replace(/[+/=]/g, 'x');
}

// Create short URL
app.post('/api/urls', async (req, res) => {
    const { url } = req.body;
    
    // Check if URL already exists
    const existing = await db.query('SELECT * FROM urls WHERE original_url = $1', [url]);
    if (existing.rows[0]) {
        return res.json({ shortUrl: `https://short.ly/${existing.rows[0].short_code}` });
    }
    
    // Generate unique short code
    let shortCode = generateShortCode(url);
    let attempts = 0;
    while (attempts < 5) {
        const exists = await db.query('SELECT 1 FROM urls WHERE short_code = $1', [shortCode]);
        if (!exists.rows[0]) break;
        shortCode = generateShortCode(url + attempts);
        attempts++;
    }
    
    // Store in database
    await db.query('INSERT INTO urls (short_code, original_url) VALUES ($1, $2)', [shortCode, url]);
    
    // Cache in Redis
    await redis.set(`url:${shortCode}`, url, 'EX', 86400);
    
    res.status(201).json({ shortUrl: `https://short.ly/${shortCode}` });
});

// Redirect to original URL
app.get('/:code', async (req, res) => {
    const { code } = req.params;
    
    // Check cache first
    let url = await redis.get(`url:${code}`);
    
    if (!url) {
        // Query database
        const result = await db.query('SELECT original_url FROM urls WHERE short_code = $1', [code]);
        if (!result.rows[0]) {
            return res.status(404).json({ error: 'URL not found' });
        }
        url = result.rows[0].original_url;
        
        // Cache for future requests
        await redis.set(`url:${code}`, url, 'EX', 86400);
    }
    
    // Increment click count (async)
    redis.incr(`clicks:${code}`);
    
    res.redirect(301, url);
});
```

#### Rate Limiter

```javascript
const redis = require('./redis');

class RateLimiter {
    constructor(windowMs, maxRequests) {
        this.windowMs = windowMs;
        this.maxRequests = maxRequests;
    }
    
    async isAllowed(key) {
        const now = Date.now();
        const windowStart = now - this.windowMs;
        
        // Remove old entries
        await redis.zremrangebyscore(key, 0, windowStart);
        
        // Count current requests
        const count = await redis.zcard(key);
        
        if (count >= this.maxRequests) {
            return false;
        }
        
        // Add current request
        await redis.zadd(key, now, `${now}-${Math.random()}`);
        await redis.expire(key, Math.ceil(this.windowMs / 1000));
        
        return true;
    }
    
    middleware() {
        return async (req, res, next) => {
            const key = `rate:${req.ip}`;
            const allowed = await this.isAllowed(key);
            
            if (!allowed) {
                return res.status(429).json({
                    error: {
                        code: 'RATE_LIMITED',
                        message: 'Too many requests',
                        retryAfter: Math.ceil(this.windowMs / 1000)
                    }
                });
            }
            
            next();
        };
    }
}

// Usage
const limiter = new RateLimiter(15 * 60 * 1000, 100); // 100 requests per 15 minutes
app.use('/api/', limiter.middleware());
```

